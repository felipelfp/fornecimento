# Cache headers para Netlify
# Assets com hash no nome = cache longo (1 ano)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML = sem cache (sempre busca novo)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Fontes = cache longo
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Imagens = cache de 30 dias
/*.png
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.ico
  Cache-Control: public, max-age=2592000

# JS e CSS com hash = cache longo
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
